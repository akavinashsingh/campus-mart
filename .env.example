# CampusMart Environment Variables

# Database
ATLASDB_URL=your_mongodb_connection_string_here

# Session Secret
SECRET=your_long_random_secret_key_here

# Cloudinary Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Token
MAP_TOKEN=your_mapbox_access_token

# Email Configuration (for nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Admin Configuration
DEFAULT_ADMIN_EMAIL=admin@campus.local
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=admin123

# SEO Configuration
BASE_URL=https://campusmart.com
# Note: Update BASE_URL to your actual production domain for proper SEO

# Node Environment
NODE_ENV=development
# Set to 'production' for production deployment
