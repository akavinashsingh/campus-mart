<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-chart-line me-2"></i><%= product.title %></h2>
            <p class="text-muted mb-0">Detailed Analytics</p>
        </div>
        <a href="/products/analytics/dashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
    </div>

    <!-- Key Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-eye fa-2x text-info mb-3"></i>
                    <h3 class="mb-1"><%= totalViews %></h3>
                    <p class="text-muted mb-0">Total Views</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-2x text-primary mb-3"></i>
                    <h3 class="mb-1"><%= uniqueViewers %></h3>
                    <p class="text-muted mb-0">Unique Viewers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <% if(totalViews < 5) { %>
                        <i class="fas fa-signal fa-2x text-danger mb-3"></i>
                    <% } else if(totalViews < 15) { %>
                        <i class="fas fa-signal fa-2x text-warning mb-3"></i>
                    <% } else { %>
                        <i class="fas fa-signal fa-2x text-success mb-3"></i>
                    <% } %>
                    <p class="text-muted mb-0">Interest Level</p>
                    <% if(totalViews < 5) { %>
                        <span class="badge bg-danger mt-2">Low</span>
                    <% } else if(totalViews < 15) { %>
                        <span class="badge bg-warning mt-2">Medium</span>
                    <% } else { %>
                        <span class="badge bg-success mt-2">High</span>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-tag fa-2x text-success mb-3"></i>
                    <h3 class="mb-1">₹<%= product.price.toLocaleString("en-IN") %></h3>
                    <p class="text-muted mb-0">Listed Price</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Details Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Product Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Category:</dt>
                        <dd class="col-sm-6"><span class="badge bg-primary"><%= product.category %></span></dd>
                        
                        <dt class="col-sm-6">Condition:</dt>
                        <dd class="col-sm-6"><span class="badge bg-info"><%= product.condition %></span></dd>
                        
                        <dt class="col-sm-6">Status:</dt>
                        <dd class="col-sm-6">
                            <% if(product.isSold) { %>
                                <span class="badge bg-secondary">Sold</span>
                            <% } else { %>
                                <span class="badge bg-success">Active</span>
                            <% } %>
                        </dd>
                        
                        <dt class="col-sm-6">Posted:</dt>
                        <dd class="col-sm-6">
                            <small><%= new Date(product.createdAt).toLocaleDateString() %></small>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Views by Day</h5>
                </div>
                <div class="card-body">
                    <% if (Object.keys(viewsByDay).length > 0) { %>
                        <div class="row">
                            <% Object.entries(viewsByDay).forEach(([date, count], index) => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <small class="text-muted d-block"><%= date %></small>
                                            <strong><%= count %> <%= count === 1 ? 'view' : 'views' %></strong>
                                        </div>
                                        <div style="width: 50px;">
                                            <div class="progress">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: <%= (count / Object.values(viewsByDay).reduce((a, b) => a + b, 0)) * 100 %>%">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted mb-0">No view data available yet. Views will appear here as people check out your listing.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Recommendations -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-lightbulb me-2"></i>Tips to Increase Interest</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="alert alert-info mb-0">
                        <h6 class="alert-heading"><i class="fas fa-images me-2"></i>High-Quality Images</h6>
                        <small>Upload clear, well-lit photos of your product from multiple angles. Products with better images get more views.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-info mb-0">
                        <h6 class="alert-heading"><i class="fas fa-pencil-alt me-2"></i>Detailed Description</h6>
                        <small>Write a comprehensive description highlighting key features, condition, and any defects. This helps buyers find your product.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-success mb-0">
                        <h6 class="alert-heading"><i class="fas fa-tag me-2"></i>Competitive Pricing</h6>
                        <small>Check similar products' prices. Reasonably priced items attract more viewers and sell faster.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-success mb-0">
                        <h6 class="alert-heading"><i class="fas fa-comments me-2"></i>Respond to Inquiries</h6>
                        <small>Quick and friendly responses encourage interested buyers to proceed. Good communication increases conversion rates.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2">
        <a href="/products/<%= product._id %>" class="btn btn-primary">
            <i class="fas fa-eye me-2"></i>View Listing
        </a>
        <% if (!product.isSold) { %>
            <a href="/products/<%= product._id %>/edit" class="btn btn-warning">
                <i class="fas fa-edit me-2"></i>Edit Listing
            </a>
        <% } %>
        <a href="/products/analytics/dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-chart-line me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<style>
    .card {
        border: none;
    }
    
    .card-header {
        border-bottom: 2px solid #f0f0f0;
    }
    
    .progress {
        height: 6px;
    }
</style>
