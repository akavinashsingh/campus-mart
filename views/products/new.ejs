<% layout("/layouts/boilerplate") %>

<section class="cm-form-page">
    <div class="cm-blob absolute" style="top:-150px; right:-100px; width:480px; height:480px; border-radius:50%; background:#A78BFA;"></div>
    <div class="cm-blob absolute" style="bottom:-100px; left:-80px; width:380px; height:380px; border-radius:50%; background:#22C55E;"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 relative">
        <div class="text-center mb-8">
            <span class="cm-pill"><span class="cm-dot"></span>Sell on CampusMart</span>
            <h1 class="font-display text-3xl sm:text-4xl font-bold text-cm-text mt-3">List your item in 3 quick steps</h1>
            <p class="text-cm-text/65 mt-2">Free, no commissions. Verified students only.</p>
        </div>

        <!-- Steps indicator -->
        <ol class="cm-steps" aria-label="Listing steps">
            <li class="cm-step is-active" data-step="1">
                <span class="cm-step-num">1</span>
                <span class="cm-step-label">Basics</span>
            </li>
            <li class="cm-step" data-step="2">
                <span class="cm-step-num">2</span>
                <span class="cm-step-label">Pricing & details</span>
            </li>
            <li class="cm-step" data-step="3">
                <span class="cm-step-num">3</span>
                <span class="cm-step-label">Photos</span>
            </li>
        </ol>

        <div class="grid lg:grid-cols-12 gap-6 mt-8">
            <!-- Form -->
            <div class="lg:col-span-7">
                <form id="cmListingForm" method="POST" action="/products" enctype="multipart/form-data" class="cm-info-card needs-validation" novalidate>
                    <!-- Step 1 -->
                    <fieldset class="cm-step-pane is-active" data-pane="1">
                        <legend class="cm-section-h">Basics</legend>
                        <div class="space-y-4">
                            <div>
                                <label class="cm-label" for="f-title">Product title <span class="cm-req">*</span></label>
                                <input id="f-title" type="text" name="product[title]" class="cm-input" placeholder="e.g. MacBook Air 2020" required maxlength="100" />
                            </div>
                            <div>
                                <label class="cm-label" for="f-desc">Description <span class="cm-req">*</span></label>
                                <textarea id="f-desc" name="product[description]" rows="5" class="cm-input" placeholder="Describe your item — accessories, condition, reason for selling…" required maxlength="2000"></textarea>
                            </div>
                            <div class="grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="cm-label" for="f-cat">Category <span class="cm-req">*</span></label>
                                    <select id="f-cat" name="product[category]" class="cm-input" required>
                                        <option value="">Select category</option>
                                        <option value="Books">Books</option>
                                        <option value="Electronics">Electronics</option>
                                        <option value="Furniture">Furniture</option>
                                        <option value="Clothing">Clothing</option>
                                        <option value="Sports">Sports</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="cm-label" for="f-cond">Condition <span class="cm-req">*</span></label>
                                    <select id="f-cond" name="product[condition]" class="cm-input" required>
                                        <option value="">Select condition</option>
                                        <option value="New">New</option>
                                        <option value="Like New">Like New</option>
                                        <option value="Good">Good</option>
                                        <option value="Fair">Fair</option>
                                        <option value="Poor">Poor</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="cm-step-actions">
                            <span></span>
                            <button type="button" class="cm-btn-action cm-btn-action-primary" data-cm-next="2">Continue</button>
                        </div>
                    </fieldset>

                    <!-- Step 2 -->
                    <fieldset class="cm-step-pane" data-pane="2" hidden>
                        <legend class="cm-section-h">Pricing & details</legend>
                        <div class="space-y-4">
                            <div class="grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="cm-label" for="f-orig">Original price (₹) <span class="cm-req">*</span></label>
                                    <input id="f-orig" type="number" name="product[originalPrice]" class="cm-input" placeholder="When new" min="0" required />
                                </div>
                                <div>
                                    <label class="cm-label" for="f-price">Your price (₹) <span class="cm-req">*</span></label>
                                    <input id="f-price" type="number" name="product[price]" class="cm-input" placeholder="Selling at" min="0" required />
                                </div>
                            </div>
                            <label class="cm-checkbox">
                                <input type="checkbox" name="product[isNegotiable]" value="true" />
                                <span>Price is negotiable — buyers can make offers.</span>
                            </label>
                            <div>
                                <label class="cm-label" for="f-loc">Pickup location <span class="cm-req">*</span></label>
                                <input id="f-loc" type="text" name="product[location]" class="cm-input" placeholder="e.g. Hostel Block A, Library, Main Gate" required />
                            </div>
                            <div>
                                <label class="cm-label" for="f-contact">Preferred contact method</label>
                                <select id="f-contact" name="product[contactMethod]" class="cm-input">
                                    <option value="WhatsApp">WhatsApp</option>
                                    <option value="Email">Email</option>
                                    <option value="Phone">Phone Call</option>
                                    <option value="In-person">In-person</option>
                                </select>
                            </div>
                        </div>
                        <div class="cm-step-actions">
                            <button type="button" class="cm-btn-action cm-btn-action-ghost" data-cm-prev="1">Back</button>
                            <button type="button" class="cm-btn-action cm-btn-action-primary" data-cm-next="3">Continue</button>
                        </div>
                    </fieldset>

                    <!-- Step 3 -->
                    <fieldset class="cm-step-pane" data-pane="3" hidden>
                        <legend class="cm-section-h">Photos</legend>
                        <div class="cm-dropzone" id="cmDropzone" tabindex="0" role="button" aria-label="Click or drop images to upload">
                            <input type="file" id="cmImages" name="product[images]" accept="image/*" multiple required hidden />
                            <div class="cm-dropzone-inner">
                                <div class="cm-dropzone-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 15-3.5-3.5L11 18"/></svg>
                                </div>
                                <h4 class="font-display font-bold text-cm-text">Drop images here</h4>
                                <p class="text-sm text-cm-text/65">or <span class="cm-link">click to browse</span> — up to 5 photos, JPG/PNG/WebP</p>
                            </div>
                        </div>
                        <div id="cmPreviewGrid" class="cm-preview-grid"></div>
                        <p class="text-xs text-cm-text/55 mt-3">Tip: First photo is the hero — pick a bright, clear shot.</p>
                        <div class="cm-step-actions">
                            <button type="button" class="cm-btn-action cm-btn-action-ghost" data-cm-prev="2">Back</button>
                            <button type="submit" class="cm-btn-action cm-btn-action-cta">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                Publish listing
                            </button>
                        </div>
                    </fieldset>
                </form>
            </div>

            <!-- Live preview -->
            <div class="lg:col-span-5">
                <div class="lg:sticky" style="top:96px;">
                    <p class="cm-section-h" style="margin-bottom:8px;">Live preview</p>
                    <div class="cm-card">
                        <div class="cm-card-img">
                            <img id="prevImg" src="https://images.unsplash.com/photo-1520975954732-35dd22299614?w=600&auto=format&fit=crop" alt="" loading="lazy" />
                            <span id="prevCond" class="cm-cond-tag" data-cond="">Condition</span>
                        </div>
                        <div class="cm-card-body">
                            <h3 class="cm-card-title" id="prevTitle">Your title appears here</h3>
                            <span class="cm-card-cat" id="prevCat">Category</span>
                            <div class="cm-card-price-row">
                                <span class="cm-card-price" id="prevPrice">₹0</span>
                                <span class="cm-card-price-old" id="prevOrig" hidden></span>
                                <span class="cm-card-disc" id="prevDisc" hidden></span>
                            </div>
                            <div class="cm-card-seller">
                                <% if (currUser && currUser.profileImage && currUser.profileImage.url) { %>
                                    <img src="<%= currUser.profileImage.url %>" alt="" loading="lazy" />
                                <% } else if (currUser) { %>
                                    <span class="cm-card-seller-init" style="background:<%= currUser.profileColor || '#7C3AED' %>;">
                                        <%= (currUser.fullName || 'U').charAt(0).toUpperCase() %>
                                    </span>
                                <% } %>
                                <span class="cm-card-seller-name"><%= currUser ? currUser.fullName : 'You' %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .cm-form-page { position: relative; overflow: hidden; min-height: 100vh; }
    .cm-info-card {
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 8px 28px -16px rgba(124,58,237,0.18);
    }
    .cm-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        list-style: none;
        padding: 0;
        max-width: 700px;
        margin: 0 auto;
    }
    .cm-step {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 14px;
        font-weight: 600;
        color: var(--cm-text);
        opacity: 0.55;
        transition: opacity .25s, border-color .25s, box-shadow .25s;
    }
    .cm-step.is-active { opacity: 1; border-color: var(--cm-primary); box-shadow: 0 4px 16px -8px rgba(124,58,237,0.35); }
    .cm-step.is-done .cm-step-num { background: var(--cm-cta); color: white; }
    .cm-step-num {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        background: var(--cm-bg);
        color: var(--cm-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Rubik', sans-serif;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }
    .cm-step.is-active .cm-step-num { background: var(--cm-primary); color: white; }
    .cm-step-label { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .cm-step-pane[hidden] { display: none; }
    .cm-step-pane { border: none; padding: 0; margin: 0; min-width: 0; }
    .cm-step-pane legend { padding: 0; margin: 0 0 16px; }
    .cm-step-actions {
        margin-top: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .cm-step-actions .cm-btn-action { width: auto; min-width: 140px; }

    .cm-section-h {
        font-family: 'Rubik', sans-serif;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--cm-muted);
    }
    .cm-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--cm-text);
        margin-bottom: 6px;
    }
    .cm-req { color: #DC2626; }
    .cm-input {
        width: 100%;
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 14px;
        color: var(--cm-ink);
        font-family: inherit;
        transition: border-color .2s, box-shadow .2s;
    }
    textarea.cm-input { resize: vertical; min-height: 96px; line-height: 1.5; }
    .cm-input:focus {
        outline: none;
        border-color: var(--cm-primary);
        box-shadow: 0 0 0 3px rgba(124,58,237,0.12);
    }
    .cm-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: var(--cm-bg);
        border: 1px solid var(--cm-border);
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        color: var(--cm-text);
        cursor: pointer;
    }
    .cm-checkbox input { width: 18px; height: 18px; accent-color: var(--cm-primary); }

    .space-y-4 > * + * { margin-top: 16px; }

    .cm-btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 12px;
        font-family: 'Rubik', sans-serif;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all .2s;
        min-height: 44px;
    }
    .cm-btn-action-primary { background: var(--cm-primary); color: white; }
    .cm-btn-action-primary:hover { background: #6D28D9; color: white; }
    .cm-btn-action-cta { background: var(--cm-cta); color: white; }
    .cm-btn-action-cta:hover { background: #16A34A; color: white; }
    .cm-btn-action-ghost { background: white; color: var(--cm-text); border-color: var(--cm-border); }
    .cm-btn-action-ghost:hover { border-color: var(--cm-primary); color: var(--cm-primary); }

    /* Dropzone */
    .cm-dropzone {
        position: relative;
        border: 2px dashed var(--cm-border);
        border-radius: 18px;
        padding: 32px 16px;
        background: var(--cm-bg);
        cursor: pointer;
        transition: all .2s;
        text-align: center;
        display: block;
    }
    .cm-dropzone:hover, .cm-dropzone:focus-visible { border-color: var(--cm-primary); background: white; outline: none; }
    .cm-dropzone.is-drag { border-color: var(--cm-cta); background: #F0FDF4; transform: scale(1.005); }
    .cm-dropzone-inner { display: flex; flex-direction: column; align-items: center; gap: 6px; pointer-events: none; }
    .cm-dropzone-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--cm-primary);
        margin-bottom: 8px;
    }
    .cm-link { color: var(--cm-primary); font-weight: 700; }
    .cm-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 10px;
        margin-top: 14px;
    }
    .cm-preview-tile {
        position: relative;
        aspect-ratio: 1 / 1;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--cm-border);
        background: white;
    }
    .cm-preview-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cm-preview-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 26px;
        height: 26px;
        border-radius: 999px;
        background: rgba(31,17,71,0.85);
        color: white;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
    }
    .cm-preview-remove:hover { background: #DC2626; }

    /* Reuse listing card preview style with same selectors */
    .cm-card { background: white; border: 1px solid var(--cm-border); border-radius: 18px; overflow: hidden; }
    .cm-card-img { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: var(--cm-bg); }
    .cm-card-img img { width: 100%; height: 100%; object-fit: cover; }
    .cm-card-body { padding: 14px; display: flex; flex-direction: column; gap: 6px; }
    .cm-card-title { font-family: 'Rubik', sans-serif; font-weight: 600; color: var(--cm-ink); margin: 0; }
    .cm-card-cat { font-size: 11px; font-weight: 600; color: var(--cm-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .cm-card-price-row { display: flex; align-items: baseline; gap: 8px; padding: 8px 10px; background: linear-gradient(135deg,#FAF5FF,#F0FDF4); border-radius: 10px; flex-wrap: wrap; }
    .cm-card-price { font-family: 'Rubik', sans-serif; font-size: 18px; font-weight: 800; color: var(--cm-primary); }
    .cm-card-price-old { font-size: 12px; color: var(--cm-muted); text-decoration: line-through; }
    .cm-card-disc { font-size: 11px; font-weight: 700; color: #16A34A; margin-left: auto; }
    .cm-card-seller { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cm-muted); }
    .cm-card-seller img, .cm-card-seller-init { width: 22px; height: 22px; border-radius: 999px; }
    .cm-card-seller-init { color: white; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px; }
    .cm-cond-tag { position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,0.95); padding: 4px 10px; border-radius: 999px; font-size: 10px; font-weight: 700; color: var(--cm-text); }
    .cm-cond-tag[data-cond="New"] { background: #DCFCE7; color: #166534; }
    .cm-cond-tag[data-cond="Like New"] { background: #DBEAFE; color: #1E40AF; }
    .cm-cond-tag[data-cond="Good"] { background: #EDE9FE; color: #5B21B6; }
    .cm-cond-tag[data-cond="Fair"] { background: #FEF3C7; color: #92400E; }
    .cm-cond-tag[data-cond="Poor"] { background: #F3F4F6; color: #374151; }
    .cm-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(10px);
        border: 1px solid var(--cm-border);
        color: var(--cm-text);
        font-size: 13px;
        font-weight: 600;
    }
    .cm-dot { width: 8px; height: 8px; border-radius: 50%; background: #22C55E; box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }

    @media (max-width: 575.98px) {
        .cm-step-label { display: none; }
    }
</style>

<script>
    (function () {
        var form = document.getElementById('cmListingForm');
        if (!form) return;
        var panes = form.querySelectorAll('.cm-step-pane');
        var steps = document.querySelectorAll('.cm-step');

        function showPane(n) {
            panes.forEach(function (p) {
                var match = p.getAttribute('data-pane') == n;
                p.hidden = !match;
                if (match) p.classList.add('is-active'); else p.classList.remove('is-active');
            });
            steps.forEach(function (s) {
                var num = Number(s.getAttribute('data-step'));
                s.classList.toggle('is-active', num == n);
                s.classList.toggle('is-done', num < n);
            });
            window.scrollTo({ top: form.offsetTop - 80, behavior: 'smooth' });
        }

        form.addEventListener('click', function (e) {
            var nextEl = e.target.closest('[data-cm-next]');
            var prevEl = e.target.closest('[data-cm-prev]');
            if (nextEl) {
                var pane = nextEl.closest('.cm-step-pane');
                if (pane && !validatePane(pane)) return;
                showPane(nextEl.getAttribute('data-cm-next'));
            } else if (prevEl) {
                showPane(prevEl.getAttribute('data-cm-prev'));
            }
        });

        function validatePane(pane) {
            var ok = true;
            pane.querySelectorAll('input, select, textarea').forEach(function (el) {
                if (el.required && !el.value) {
                    el.classList.add('is-invalid');
                    el.style.borderColor = '#DC2626';
                    ok = false;
                } else {
                    el.classList.remove('is-invalid');
                    el.style.borderColor = '';
                }
            });
            return ok;
        }

        // Live preview wiring
        var prevTitle = document.getElementById('prevTitle');
        var prevCat   = document.getElementById('prevCat');
        var prevCond  = document.getElementById('prevCond');
        var prevPrice = document.getElementById('prevPrice');
        var prevOrig  = document.getElementById('prevOrig');
        var prevDisc  = document.getElementById('prevDisc');
        var prevImg   = document.getElementById('prevImg');

        document.getElementById('f-title').addEventListener('input', function () {
            prevTitle.textContent = this.value || 'Your title appears here';
        });
        document.getElementById('f-cat').addEventListener('change', function () {
            prevCat.textContent = this.value || 'Category';
        });
        document.getElementById('f-cond').addEventListener('change', function () {
            prevCond.textContent = this.value || 'Condition';
            prevCond.setAttribute('data-cond', this.value || '');
        });
        function updatePrice() {
            var p = Number(document.getElementById('f-price').value) || 0;
            var o = Number(document.getElementById('f-orig').value) || 0;
            prevPrice.textContent = '₹' + p.toLocaleString('en-IN');
            if (o > p && p > 0) {
                prevOrig.textContent = '₹' + o.toLocaleString('en-IN');
                prevOrig.hidden = false;
                var disc = Math.round((1 - p/o) * 100);
                prevDisc.textContent = disc + '% off';
                prevDisc.hidden = disc <= 0;
            } else {
                prevOrig.hidden = true;
                prevDisc.hidden = true;
            }
        }
        document.getElementById('f-price').addEventListener('input', updatePrice);
        document.getElementById('f-orig').addEventListener('input', updatePrice);

        // Drag and drop
        var dropzone = document.getElementById('cmDropzone');
        var fileInput = document.getElementById('cmImages');
        var grid = document.getElementById('cmPreviewGrid');
        var tracked = []; // DataTransfer-like store

        dropzone.addEventListener('click', function () { fileInput.click(); });
        dropzone.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
        });
        dropzone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropzone.classList.add('is-drag');
        });
        dropzone.addEventListener('dragleave', function () { dropzone.classList.remove('is-drag'); });
        dropzone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropzone.classList.remove('is-drag');
            handleFiles(e.dataTransfer.files);
        });
        fileInput.addEventListener('change', function () { handleFiles(fileInput.files, true); });

        function handleFiles(fileList, replace) {
            if (replace) tracked = [];
            Array.from(fileList).forEach(function (f) {
                if (tracked.length >= 5) return;
                if (!f.type.startsWith('image/')) return;
                tracked.push(f);
            });
            syncInput();
            renderPreview();
        }
        function syncInput() {
            var dt = new DataTransfer();
            tracked.forEach(function (f) { dt.items.add(f); });
            fileInput.files = dt.files;
        }
        function renderPreview() {
            grid.innerHTML = '';
            tracked.forEach(function (f, i) {
                var url = URL.createObjectURL(f);
                var tile = document.createElement('div');
                tile.className = 'cm-preview-tile';
                tile.innerHTML = '<img src="' + url + '" alt="">' +
                                 '<button type="button" class="cm-preview-remove" aria-label="Remove image ' + (i+1) + '">&times;</button>';
                tile.querySelector('button').addEventListener('click', function () {
                    tracked.splice(i, 1);
                    syncInput();
                    renderPreview();
                });
                grid.appendChild(tile);
                if (i === 0) prevImg.src = url;
            });
            if (tracked.length === 0) {
                prevImg.src = 'https://images.unsplash.com/photo-1520975954732-35dd22299614?w=600&auto=format&fit=crop';
            }
        }
    })();
</script>
