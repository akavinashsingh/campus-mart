<% layout("/layouts/boilerplate") %>

<!-- Animated Hero Section -->
<div class="hero-section">
    <div class="animated-bg">
        <div class="floating-element floating-book">
            <i class="fas fa-book"></i>
        </div>
        <div class="floating-element floating-laptop">
            <i class="fas fa-laptop"></i>
        </div>
        <div class="floating-element floating-dumbbell">
            <i class="fas fa-dumbbell"></i>
        </div>
        <div class="floating-element floating-soccer">
            <i class="fas fa-futbol"></i>
        </div>
        <div class="floating-element floating-graduation">
            <i class="fas fa-graduation-cap"></i>
        </div>
        <div class="floating-element floating-pencil">
            <i class="fas fa-pencil-alt"></i>
        </div>
        <div class="gradient-circle circle-1"></div>
        <div class="gradient-circle circle-2"></div>
        <div class="gradient-circle circle-3"></div>
    </div>
    <div class="hero-content">
        <h1 class="hero-title">Welcome to CampusMart</h1>
        <p class="hero-subtitle">Your Ultimate Campus Marketplace for Books, Electronics, Sports & More</p>
        <% if(!currUser) { %>
            <div class="hero-cta">
                <a href="/login" class="btn btn-light btn-lg shadow-sm">
                    <i class="fas fa-sign-in-alt me-2"></i>Login to Buy/Sell
                </a>
            </div>
        <% } %>
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">📚</span>
                <p>Academic Items</p>
            </div>
            <div class="stat-item">
                <span class="stat-number">💻</span>
                <p>Tech & Electronics</p>
            </div>
            <div class="stat-item">
                <span class="stat-number">⚽</span>
                <p>Sports & Fitness</p>
            </div>
            <div class="stat-item">
                <span class="stat-number">🏆</span>
                <p>Best Deals</p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-3">
    <div class="d-md-none mb-3">
        <button class="btn btn-outline-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#mobileFilters" aria-expanded="false" aria-controls="mobileFilters">
            <i class="fas fa-filter me-2"></i>Show Filters
        </button>
    </div>
    <div class="row">
        <!-- Mobile Filters (collapsed) -->
        <div class="col-12 d-md-none">
            <div class="collapse mb-3" id="mobileFilters">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="fas fa-filter me-2"></i>Filters
                        </h5>
                        <form action="/products" method="GET" id="filterFormMobile">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Category</label>
                                <select class="form-select" name="category" onchange="this.form.submit()">
                                    <option value="">All Categories</option>
                                    <option value="Books" <%= filters?.category === 'Books' ? 'selected' : '' %>>Books</option>
                                    <option value="Electronics" <%= filters?.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
                                    <option value="Furniture" <%= filters?.category === 'Furniture' ? 'selected' : '' %>>Furniture</option>
                                    <option value="Clothing" <%= filters?.category === 'Clothing' ? 'selected' : '' %>>Clothing</option>
                                    <option value="Sports" <%= filters?.category === 'Sports' ? 'selected' : '' %>>Sports</option>
                                    <option value="Other" <%= filters?.category === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Condition</label>
                                <select class="form-select" name="condition" onchange="this.form.submit()">
                                    <option value="">Any Condition</option>
                                    <option value="New" <%= filters?.condition === 'New' ? 'selected' : '' %>>New</option>
                                    <option value="Like New" <%= filters?.condition === 'Like New' ? 'selected' : '' %>>Like New</option>
                                    <option value="Good" <%= filters?.condition === 'Good' ? 'selected' : '' %>>Good</option>
                                    <option value="Fair" <%= filters?.condition === 'Fair' ? 'selected' : '' %>>Fair</option>
                                    <option value="Poor" <%= filters?.condition === 'Poor' ? 'selected' : '' %>>Poor</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Price Range</label>
                                <div class="mb-2">
                                    <input type="range" class="form-range" id="priceRangeMaxMobile" min="0" max="50000" step="100" 
                                           value="<%= filters?.maxPrice || 50000 %>">
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span>₹0</span>
                                        <span id="maxPriceDisplayMobile">₹<%= (filters?.maxPrice || 50000).toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col">
                                        <input type="number" class="form-control form-control-sm" name="minPrice" 
                                               id="minPriceInputMobile" placeholder="Min" min="0" 
                                               value="<%= filters?.minPrice || '' %>">
                                    </div>
                                    <div class="col">
                                        <input type="number" class="form-control form-control-sm" name="maxPrice" 
                                               id="maxPriceInputMobile" placeholder="Max" min="0" 
                                               value="<%= filters?.maxPrice || '' %>">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">College</label>
                                <input type="text" class="form-control" name="college" 
                                       placeholder="Enter college name" value="<%= filters?.college || '' %>">
                            </div>
                            
                            <input type="hidden" name="sort" value="<%= filters?.sort || '' %>">
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-check me-2"></i>Apply Filters
                                </button>
                                <a href="/products" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-redo me-2"></i>Reset All
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Desktop Filters -->
        <div class="col-md-3 mb-4 d-none d-md-block">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="fas fa-filter me-2"></i>Filters
                    </h5>
                    <form action="/products" method="GET" id="filterFormDesktop">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Category</label>
                            <select class="form-select" name="category" onchange="this.form.submit()">
                                <option value="">All Categories</option>
                                <option value="Books" <%= filters?.category === 'Books' ? 'selected' : '' %>>Books</option>
                                <option value="Electronics" <%= filters?.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
                                <option value="Furniture" <%= filters?.category === 'Furniture' ? 'selected' : '' %>>Furniture</option>
                                <option value="Clothing" <%= filters?.category === 'Clothing' ? 'selected' : '' %>>Clothing</option>
                                <option value="Sports" <%= filters?.category === 'Sports' ? 'selected' : '' %>>Sports</option>
                                <option value="Other" <%= filters?.category === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Condition</label>
                            <select class="form-select" name="condition" onchange="this.form.submit()">
                                <option value="">Any Condition</option>
                                <option value="New" <%= filters?.condition === 'New' ? 'selected' : '' %>>New</option>
                                <option value="Like New" <%= filters?.condition === 'Like New' ? 'selected' : '' %>>Like New</option>
                                <option value="Good" <%= filters?.condition === 'Good' ? 'selected' : '' %>>Good</option>
                                <option value="Fair" <%= filters?.condition === 'Fair' ? 'selected' : '' %>>Fair</option>
                                <option value="Poor" <%= filters?.condition === 'Poor' ? 'selected' : '' %>>Poor</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price Range</label>
                            <div class="mb-2">
                                <input type="range" class="form-range" id="priceRangeMax" min="0" max="50000" step="100" 
                                       value="<%= filters?.maxPrice || 50000 %>">
                                <div class="d-flex justify-content-between text-muted small">
                                    <span>₹0</span>
                                    <span id="maxPriceDisplay">₹<%= (filters?.maxPrice || 50000).toLocaleString('en-IN') %></span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col">
                                    <input type="number" class="form-control form-control-sm" name="minPrice" 
                                           id="minPriceInput" placeholder="Min" min="0" 
                                           value="<%= filters?.minPrice || '' %>">
                                </div>
                                <div class="col">
                                    <input type="number" class="form-control form-control-sm" name="maxPrice" 
                                           id="maxPriceInput" placeholder="Max" min="0" 
                                           value="<%= filters?.maxPrice || '' %>">
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">College</label>
                            <input type="text" class="form-control" name="college" 
                                   placeholder="Enter college name" value="<%= filters?.college || '' %>">
                        </div>
                        
                        <input type="hidden" name="sort" value="<%= filters?.sort || '' %>">
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-2"></i>Apply Filters
                            </button>
                            <a href="/products" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-redo me-2"></i>Reset All
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Product Listings -->
        <div class="col-md-9">
            <!-- Header with sort and count -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">
                    <i class="fas fa-box me-2"></i>
                    <span class="text-muted fw-normal">Found <%= allProducts.length %> items</span>
                </h4>
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0 text-muted small">Sort by:</label>
                    <select class="form-select form-select-sm" style="width: auto;" onchange="sortProducts(this.value)">
                        <option value="newest" <%= filters?.sort === 'newest' || !filters?.sort ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%= filters?.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="price-low" <%= filters?.sort === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price-high" <%= filters?.sort === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
                    </select>
                </div>
            </div>
            
            <div class="row g-3">
                <% if(allProducts.length === 0) { %>
                    <div class="col-12">
                        <div class="alert alert-info">
                            No products found. Be the first to list an item!
                        </div>
                    </div>
                <% } %>
                
                <% for(let product of allProducts) { %>
                    <div class="col-6 col-md-6 col-lg-4 col-xl-3">
                        <a href="/products/<%= product._id %>" class="product-card-link">
                            <div class="card product-card h-100 shadow-sm">
                                <!-- Product Image Container -->
                                <div class="product-image-container position-relative">
                                    <img src="<%= product.images[0] ? product.images[0].url : '/images/default-product.jpg' %>" 
                                         class="card-img-top product-image" 
                                         alt="<%= product.title %>">
                                    
                                    <% if(product.isSold) { %>
                                        <div class="sold-badge">SOLD</div>
                                    <% } %>
                                    
                                    <!-- View Count Badge -->
                                    <div class="view-badge">
                                        <i class="fas fa-eye"></i> <%= product.viewCount || 0 %>
                                    </div>
                                    
                                    <!-- Condition Badge -->
                                    <div class="condition-badge badge bg-<%= 
                                        product.condition === 'New' ? 'success' : 
                                        product.condition === 'Like New' ? 'info' : 
                                        product.condition === 'Good' ? 'primary' : 'secondary' 
                                    %>">
                                        <%= product.condition %>
                                    </div>
                                </div>
                                
                                <div class="card-body p-2 d-flex flex-column">
                                    <!-- Title -->
                                    <h6 class="card-title mb-1 text-truncate" title="<%= product.title %>">
                                        <%= product.title %>
                                    </h6>
                                    
                                    <!-- Meta Info -->
                                    <div class="meta-info mb-1">
                                        <small class="text-muted d-block lh-1">
                                            <i class="fas fa-tag me-1" style="color: #6c757d; font-size: 10px;"></i><%= product.category %>
                                        </small>
                                    </div>
                                    
                                    <!-- Price Section -->
                                    <div class="price-section mb-1">
                                        <div class="d-flex align-items-baseline gap-1">
                                            <span class="price-main text-primary fw-bold">
                                                ₹<%= product.price.toLocaleString("en-IN") %>
                                            </span>
                                            <span class="price-original text-muted text-decoration-line-through" style="font-size: 11px;">
                                                ₹<%= product.originalPrice.toLocaleString("en-IN") %>
                                            </span>
                                        </div>
                                        <% let discount = Math.round((1 - product.price/product.originalPrice) * 100); %>
                                        <% if(discount > 0) { %>
                                            <small class="text-success fw-semibold" style="font-size: 11px;">
                                                <i class="fas fa-arrow-down me-1"></i><%= discount %>% off
                                            </small>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Seller Info -->
                                    <div class="seller-info">
                                        <% if(product.owner && product.owner.profileImage && product.owner.profileImage.url) { %>
                                            <img src="<%= product.owner.profileImage.url %>" 
                                                 class="rounded-circle me-1" 
                                                 width="20" height="20" 
                                                 style="object-fit: cover;"
                                                 alt="<%= product.owner.fullName %>">
                                        <% } else if(product.owner) { %>
                                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-1" 
                                                 style="width: 20px; height: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); font-size: 9px; color: white;">
                                                <%= product.owner.fullName.charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <small class="text-muted fw-medium" style="font-size: 11px;">
                                            <%= product.owner ? product.owner.fullName : 'Unknown' %>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card Link Wrapper */
    .product-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
        height: 100%;
    }
    
    /* Card Styling */
    .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #e9ecef;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        height: 100%;
        cursor: pointer;
        position: relative;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    
    .product-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 12px;
        padding: 2px;
        background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .product-card-link:hover .product-card {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(102, 126, 234, 0.25) !important;
    }
    
    .product-card-link:hover .product-card::before {
        opacity: 1;
    }
    
    /* Image Container */
    .product-image-container {
        position: relative;
        overflow: hidden;
        background: #f8f9fa;
        aspect-ratio: 1;
    }
    
    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    
    .product-card-link:hover .product-image {
        transform: scale(1.1);
    }
    
    /* Badges */
    .sold-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(220, 53, 69, 0.95);
        color: white;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 10px;
        z-index: 2;
        backdrop-filter: blur(4px);
    }
    
    .view-badge {
        position: absolute;
        bottom: 6px;
        left: 6px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        z-index: 2;
        backdrop-filter: blur(8px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
    
    .view-badge i {
        margin-right: 3px;
    }
    
    .condition-badge {
        position: absolute;
        top: 6px;
        left: 6px;
        font-size: 10px;
        font-weight: 600;
        padding: 4px 10px !important;
        z-index: 2;
        border-radius: 20px !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(8px);
    }
    
    /* Card Body */
    .card-body {
        padding: 8px !important;
    }
    
    .card-title {
        font-size: 13px;
        font-weight: 600;
        line-height: 1.3;
        color: #212529;
        margin-bottom: 4px !important;
    }
    
    .meta-info {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin-bottom: 4px !important;
    }
    
    .meta-info small {
        font-size: 11px;
        line-height: 1.2;
    }
    
    /* Price Section */
    .price-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 8px 10px;
        border-radius: 8px;
        margin-bottom: 4px !important;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .price-main {
        font-size: 14px;
    }
    
    .price-original {
        font-size: 11px;
    }
    
    /* Seller Info */
    .seller-info {
        display: flex;
        align-items: center;
        font-size: 11px;
        gap: 3px;
    }
    
    .seller-info small {
        margin: 0;
        line-height: 1.2;
    }
    
    /* Hero Section Animations */
    .hero-section {
        position: relative;
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 -12px;
        padding: 30px 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
        box-shadow: inset 0 -4px 20px rgba(0, 0, 0, 0.1);
    }
    
    .animated-bg {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: 1;
        overflow: hidden;
    }
    
    /* Gradient Circles */
    .gradient-circle {
        position: absolute;
        border-radius: 50%;
        opacity: 0.15;
        mix-blend-mode: screen;
    }
    
    .circle-1 {
        width: 220px;
        height: 220px;
        background: rgba(255, 255, 255, 0.5);
        top: -110px;
        right: -110px;
        animation: float 20s infinite ease-in-out;
    }
    
    .circle-2 {
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.3);
        bottom: -75px;
        left: 10%;
        animation: float 25s infinite ease-in-out;
        animation-delay: 2s;
    }
    
    .circle-3 {
        width: 180px;
        height: 180px;
        background: rgba(255, 255, 255, 0.4);
        bottom: 20%;
        right: 5%;
        animation: float 22s infinite ease-in-out;
        animation-delay: 4s;
    }
    
    /* Floating Elements */
    .floating-element {
        position: absolute;
        font-size: 44px;
        opacity: 0.8;
        z-index: 2;
        animation: float 6s infinite ease-in-out;
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    }
    
    .floating-book {
        top: 10%;
        left: 5%;
        animation-delay: 0s;
    }
    
    .floating-laptop {
        top: 20%;
        right: 8%;
        animation-delay: 1s;
        font-size: 38px;
    }
    
    .floating-dumbbell {
        bottom: 15%;
        left: 8%;
        animation-delay: 2s;
        font-size: 34px;
    }
    
    .floating-soccer {
        top: 30%;
        left: 50%;
        animation-delay: 0.5s;
    }
    
    .floating-graduation {
        bottom: 25%;
        right: 12%;
        animation-delay: 1.5s;
        font-size: 40px;
    }
    
    .floating-pencil {
        top: 15%;
        left: 25%;
        animation-delay: 2.5s;
        font-size: 30px;
    }
    
    @keyframes float {
        0%, 100% {
            transform: translateY(0px) translateX(0px) rotate(0deg);
        }
        25% {
            transform: translateY(-20px) translateX(10px) rotate(5deg);
        }
        50% {
            transform: translateY(-40px) translateX(-10px) rotate(-5deg);
        }
        75% {
            transform: translateY(-20px) translateX(15px) rotate(3deg);
        }
    }
    
    /* Hero Content */
    .hero-content {
        position: relative;
        z-index: 3;
        text-align: center;
        color: white;
        animation: slideUp 0.8s ease-out;
    }
    
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .hero-title {
        font-size: 2.4rem;
        font-weight: 800;
        margin-bottom: 10px;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        letter-spacing: -1px;
    }
    
    .hero-subtitle {
        font-size: 1.05rem;
        margin-bottom: 24px;
        opacity: 0.95;
        font-weight: 300;
    }
    
    /* Hero CTA */
    .hero-cta {
        margin: 20px 0 10px;
        animation: fadeInUp 1s ease-out 0.3s both;
    }
    
    .hero-cta .btn {
        font-weight: 600;
        padding: 14px 36px;
        border-radius: 50px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 1.1rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%) !important;
        border: 2px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }
    
    .hero-cta .btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.5s;
