<script>
    // Sort handler
    function sortProducts(sortValue) {
        var urlParams = new URLSearchParams(window.location.search);
        urlParams.set('sort', sortValue);
        window.location.href = '/products?' + urlParams.toString();
    }

    // Price range sync
    (function () {
        function bindRange(rangeId, displayId, inputId) {
            var range = document.getElementById(rangeId);
            var disp  = document.getElementById(displayId);
            var input = document.getElementById(inputId);
            if (!range || !disp || !input) return;
            range.addEventListener('input', function () {
                disp.textContent = '₹' + Number(this.value).toLocaleString('en-IN');
                input.value = this.value;
            });
            input.addEventListener('input', function () {
                if (this.value && this.value <= 50000) {
                    range.value = this.value;
                    disp.textContent = '₹' + Number(this.value).toLocaleString('en-IN');
                }
            });
        }
        bindRange('priceRangeMax',       'maxPriceDisplay',       'maxPriceInput');
        bindRange('priceRangeMaxMobile', 'maxPriceDisplayMobile', 'maxPriceInputMobile');
    })();

    // Mobile filter sheet
    (function () {
        var trigger = document.querySelector('[data-cm-toggle="filter-sheet"]');
        var sheet   = document.getElementById('cmFilterSheet');
        var scrim   = document.getElementById('cmFilterScrim');
        var close   = document.getElementById('cmFilterClose');
        if (!trigger || !sheet || !scrim || !close) return;

        function open() {
            scrim.hidden = false;
            requestAnimationFrame(function () {
                scrim.classList.add('is-open');
                sheet.classList.add('is-open');
            });
            sheet.setAttribute('aria-hidden', 'false');
            trigger.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }
        function shut() {
            scrim.classList.remove('is-open');
            sheet.classList.remove('is-open');
            sheet.setAttribute('aria-hidden', 'true');
            trigger.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            setTimeout(function () { scrim.hidden = true; }, 300);
        }
        trigger.addEventListener('click', open);
        close.addEventListener('click', shut);
        scrim.addEventListener('click', shut);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && sheet.classList.contains('is-open')) shut();
        });
    })();
</script>
