<script>
    // Thumbnail active sync
    document.querySelectorAll('.cm-thumb').forEach(function (thumb) {
        thumb.addEventListener('click', function () {
            document.querySelectorAll('.cm-thumb').forEach(function (t) { t.classList.remove('is-active'); });
            this.classList.add('is-active');
        });
    });

    // Save toggle
    (function () {
        var btn = document.getElementById('saveBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var pid = btn.getAttribute('data-product-id');
            var saved = btn.getAttribute('data-saved') === 'true';
            fetch('/products/' + pid + '/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: saved ? 'unsave' : 'save' })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.success) {
                    var nowSaved = !saved;
                    btn.setAttribute('data-saved', nowSaved);
                    btn.classList.toggle('is-saved', nowSaved);
                    var txt = document.getElementById('saveBtnText');
                    if (txt) txt.textContent = nowSaved ? 'Saved' : 'Save item';
                    var svg = btn.querySelector('svg');
                    if (svg) svg.setAttribute('fill', nowSaved ? 'currentColor' : 'none');
                } else {
                    window.location.href = '/login';
                }
            })
            .catch(function () { window.location.href = '/login'; });
        });
    })();

    // Contact log
    function logContact(event, productId, method) {
        if (method === 'In-person') event.preventDefault();
        fetch('/products/' + productId + '/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contactMethod: method })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data && data.success && method === 'In-person') {
                alert('Your interest has been noted! The seller will be notified.');
            }
        })
        .catch(function (err) { console.error('Error logging contact:', err); });
    }

    // Send offer (lightweight: opens contact channel with pre-filled message)
    function sendOffer(productId) {
        var input = document.getElementById('offerAmount');
        if (!input || !input.value) { alert('Please enter an offer amount.'); return; }
        var amount = Number(input.value);
        if (!amount || amount < 1) { alert('Enter a valid amount.'); return; }
        fetch('/products/' + productId + '/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contactMethod: 'Offer', offerAmount: amount })
        }).finally(function () {
            alert('Offer of ₹' + amount.toLocaleString('en-IN') + ' sent to the seller.');
            var modal = bootstrap.Modal.getInstance(document.getElementById('offerModal'));
            if (modal) modal.hide();
        });
    }
</script>
