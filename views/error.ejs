<% layout("/layouts/boilerplate") %>

<section class="cm-error-wrap">
    <div class="cm-blob absolute" style="top:-120px; left:-80px; width:380px; height:380px; border-radius:50%; background:#A78BFA;"></div>
    <div class="cm-blob absolute" style="bottom:-100px; right:-60px; width:340px; height:340px; border-radius:50%; background:#22C55E;"></div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 relative">
        <div class="cm-glass rounded-3xl p-8 sm:p-12 text-center shadow-cm-glow">
            <div class="cm-error-art" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="20" y="50" width="200" height="90" rx="12" fill="rgba(167,139,250,0.18)" stroke="#A78BFA"/>
                    <path d="M20 70h200" stroke="#A78BFA"/>
                    <circle cx="34" cy="60" r="3" fill="#7C3AED" stroke="none"/>
                    <circle cx="46" cy="60" r="3" fill="#A78BFA" stroke="none"/>
                    <circle cx="58" cy="60" r="3" fill="#22C55E" stroke="none"/>
                    <text x="120" y="115" text-anchor="middle" font-family="Rubik" font-weight="800" font-size="44" fill="#7C3AED" stroke="none"><%= typeof statusCode !== 'undefined' ? statusCode : 'Error' %></text>
                </svg>
            </div>

            <h1 class="font-display text-3xl sm:text-4xl font-bold text-cm-text mt-6">
                <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
                    Page not found
                <% } else if (typeof statusCode !== 'undefined' && statusCode === 403) { %>
                    Access denied
                <% } else { %>
                    Something went sideways
                <% } %>
            </h1>
            <p class="mt-3 text-cm-text/70 max-w-lg mx-auto">
                <%= message %>
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="/products" class="cm-btn-primary cm-focus" style="padding:12px 24px;font-size:15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg>
                    Back to marketplace
                </a>
                <a href="javascript:history.back()" class="cm-btn-ghost cm-focus" style="border:1px solid var(--cm-border);">
                    Go back
                </a>
            </div>

            <div class="mt-10 pt-6 border-t border-cm-text/10 text-sm text-cm-text/60">
                Need help? Email
                <a href="mailto:23uj1a0504@mrem.ac.in" class="text-cm-primary font-semibold hover:underline">
                    23uj1a0504@mrem.ac.in
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .cm-error-wrap {
        position: relative;
        overflow: hidden;
        min-height: calc(100vh - 200px);
    }
    .cm-error-art {
        max-width: 240px;
        margin: 0 auto;
        color: var(--cm-primary);
    }
</style>
