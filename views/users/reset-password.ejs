<%- layout('layouts/boilerplate.ejs') %>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">Reset Password</h4>
                    
                    <p class="text-muted text-center mb-4">
                        Enter your new password below.
                    </p>

                    <form action="/reset-password/<%= token %>" method="POST" class="mb-3">
                        <div class="mb-3">
                            <label for="password" class="form-label">New Password</label>
                            <input 
                                type="password" 
                                class="form-control" 
                                id="password" 
                                name="password" 
                                placeholder="Enter new password"
                                required
                            />
                            <small class="form-text text-muted d-block mt-1">
                                Password must be at least 6 characters.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <input 
                                type="password" 
                                class="form-control" 
                                id="confirmPassword" 
                                name="confirmPassword" 
                                placeholder="Confirm your password"
                                required
                            />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Reset Password
                        </button>
                    </form>

                    <hr>

                    <p class="text-center text-muted">
                        Don't need to reset? 
                        <a href="/login" class="text-decoration-none">Go back to login</a>
                    </p>                    
                    <hr>
                    
                    <small class="d-block text-center text-muted mb-2">Having trouble resetting your password?</small>
                    <p class="text-center mb-0">
                        <a href="mailto:23uj1a0504@mrem.ac.in?subject=Password Reset Help" class="text-decoration-none btn btn-sm btn-outline-secondary w-100">
                            <i class="fas fa-envelope me-1"></i>Contact Support
                        </a>
                    </p>                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-body {
        padding: 2rem;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    .text-muted {
        font-size: 0.95rem;
        line-height: 1.6;
    }
</style>
