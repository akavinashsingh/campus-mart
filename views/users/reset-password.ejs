<%- layout('layouts/boilerplate.ejs') %>

<%- include("../includes/_auth-styles") %>

<section class="cm-auth">
    <div class="cm-auth-grid">
        <aside class="cm-auth-brand" aria-hidden="true">
            <div class="cm-blob absolute" style="top:-100px; left:-60px; width:340px; height:340px; border-radius:50%; background:#22C55E;"></div>
            <div class="cm-blob absolute" style="bottom:-80px; right:-40px; width:300px; height:300px; border-radius:50%; background:#7C3AED;"></div>
            <div class="cm-auth-brand-inner">
                <a href="/products" class="cm-auth-brand-logo">
                    <span class="cm-brand-mark">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg>
                    </span>
                    <span>CampusMart</span>
                </a>
                <h2 class="cm-auth-tagline">Choose a new password.</h2>
                <p class="cm-auth-subtagline">Pick something memorable but tough — at least 6 characters.</p>
                <ul class="cm-auth-bullets">
                    <li><span>Use letters &amp; numbers</span></li>
                    <li><span>Avoid common passwords</span></li>
                </ul>
            </div>
        </aside>

        <div class="cm-auth-form-wrap">
            <div class="cm-auth-card">
                <div class="cm-auth-card-head">
                    <h1 class="font-display text-3xl font-bold text-cm-text">New password</h1>
                    <p class="text-cm-text/65 mt-1">Enter your new password below.</p>
                </div>

                <form action="/reset-password/<%= token %>" method="POST" class="space-y-4">
                    <div>
                        <label class="cm-label" for="password">New password</label>
                        <input id="password" name="password" type="password" class="cm-input" minlength="6" autocomplete="new-password" required />
                        <p class="text-xs text-cm-text/55 mt-1">At least 6 characters.</p>
                    </div>
                    <div>
                        <label class="cm-label" for="confirmPassword">Confirm password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="cm-input" minlength="6" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="cm-btn-action cm-btn-action-primary w-full">
                        Reset password
                    </button>
                </form>

                <div class="cm-auth-divider"><span>or</span></div>

                <p class="text-center text-sm text-cm-text/70">
                    Don't need to reset?
                    <a href="/login" class="font-semibold text-cm-primary hover:underline">Back to login</a>
                </p>

                <div class="cm-auth-support">
                    <span>Trouble resetting?</span>
                    <a href="mailto:23uj1a0504@mrem.ac.in?subject=Password Reset Help">Contact support</a>
                </div>
            </div>
        </div>
    </div>
</section>
