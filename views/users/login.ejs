<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0"><i class="fas fa-sign-in-alt me-2"></i>Login</h3>
                </div>
                <div class="card-body p-4">
                    <form action="/login" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input name="username" type="text" id="username" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input name="password" type="password" id="password" class="form-control" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg">Login</button>
                        </div>
                    </form>
                    <hr>
                    <p class="text-center mb-0">New student? <a href="/signup" class="text-decoration-none">Create account</a></p>
                </div>
            </div>
        </div>
    </div>
</div>