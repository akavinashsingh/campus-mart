<%- layout('layouts/boilerplate.ejs') %>

<%- include("../includes/_auth-styles") %>

<section class="cm-auth">
    <div class="cm-auth-grid">
        <aside class="cm-auth-brand" aria-hidden="true">
            <div class="cm-blob absolute" style="top:-100px; left:-60px; width:340px; height:340px; border-radius:50%; background:#F59E0B;"></div>
            <div class="cm-blob absolute" style="bottom:-80px; right:-40px; width:300px; height:300px; border-radius:50%; background:#A78BFA;"></div>
            <div class="cm-auth-brand-inner">
                <a href="/products" class="cm-auth-brand-logo">
                    <span class="cm-brand-mark">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg>
                    </span>
                    <span>CampusMart</span>
                </a>
                <h2 class="cm-auth-tagline">Forgot your password?</h2>
                <p class="cm-auth-subtagline">It happens. We'll email you a secure link to set a new one.</p>
                <ul class="cm-auth-bullets">
                    <li><span>Reset link expires in 1 hour</span></li>
                    <li><span>Sent to your college email only</span></li>
                </ul>
            </div>
        </aside>

        <div class="cm-auth-form-wrap">
            <div class="cm-auth-card">
                <div class="cm-auth-card-head">
                    <h1 class="font-display text-3xl font-bold text-cm-text">Reset password</h1>
                    <p class="text-cm-text/65 mt-1">Enter your email and we'll send a reset link.</p>
                </div>

                <form action="/forgot-password" method="POST" class="space-y-4">
                    <div>
                        <label class="cm-label" for="email">Email address</label>
                        <input id="email" name="email" type="email" class="cm-input" placeholder="name@college.edu" required />
                    </div>
                    <button type="submit" class="cm-btn-action cm-btn-action-primary w-full">
                        Send reset link
                    </button>
                </form>

                <div class="cm-auth-divider"><span>or</span></div>

                <p class="text-center text-sm text-cm-text/70">
                    Remembered it?
                    <a href="/login" class="font-semibold text-cm-primary hover:underline">Back to login</a>
                </p>

                <div class="cm-auth-support">
                    <span>Not receiving the email?</span>
                    <a href="mailto:23uj1a0504@mrem.ac.in?subject=Password Reset Issue">Contact support</a>
                </div>
            </div>
        </div>
    </div>
</section>
