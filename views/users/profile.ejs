<% layout("/layouts/boilerplate") %>

<section class="cm-dashboard">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

        <!-- Header card (bento style) -->
        <div class="cm-info-card cm-profile-header">
            <div class="cm-profile-bg" aria-hidden="true">
                <div class="cm-blob absolute" style="top:-80px; right:-40px; width:280px; height:280px; border-radius:50%; background:#A78BFA;"></div>
                <div class="cm-blob absolute" style="bottom:-80px; left:-40px; width:240px; height:240px; border-radius:50%; background:#22C55E;"></div>
            </div>
            <div class="cm-profile-row">
                <% if (user.profileImage && user.profileImage.url) { %>
                    <img src="<%= user.profileImage.url %>" alt="<%= user.fullName %>" class="cm-profile-avatar" loading="lazy" />
                <% } else { %>
                    <span class="cm-profile-avatar cm-profile-avatar-init" style="background:<%= user.profileColor || '#7C3AED' %>;">
                        <%= user.fullName.charAt(0).toUpperCase() %>
                    </span>
                <% } %>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="font-display text-2xl sm:text-3xl font-bold text-cm-text m-0"><%= user.fullName %></h1>
                        <% if (user.isVerified) { %>
                            <span class="cm-badge-verified" title="Verified student" aria-label="Verified student">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><path d="M21 12c0 5.5-9 10-9 10s-9-4.5-9-10a9 9 0 0 1 18 0Z"/></svg>
                                Verified
                            </span>
                        <% } %>
                    </div>
                    <ul class="cm-profile-meta">
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg>
                            <%= user.email %>
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
                            <%= user.phone %>
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg>
                            <%= user.college %>
                        </li>
                    </ul>
                </div>
                <button class="cm-btn-action cm-btn-action-ghost" data-bs-toggle="modal" data-bs-target="#editProfileModal" type="button" style="white-space:nowrap;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    Edit profile
                </button>
            </div>
        </div>

        <!-- Bento stats -->
        <div class="cm-bento mt-6">
            <div class="cm-stat-card cm-stat-card-violet">
                <div class="cm-stat-icon-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg>
                </div>
                <div>
                    <div class="cm-stat-num" id="totalListings">0</div>
                    <div class="cm-stat-lbl">Total listings</div>
                </div>
            </div>
            <div class="cm-stat-card cm-stat-card-emerald">
                <div class="cm-stat-icon-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18l-2 13H5L3 7Z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
                </div>
                <div>
                    <div class="cm-stat-num" id="activeListings">0</div>
                    <div class="cm-stat-lbl">Active</div>
                </div>
            </div>
            <div class="cm-stat-card cm-stat-card-blue">
                <div class="cm-stat-icon-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <div>
                    <div class="cm-stat-num" id="soldItems">0</div>
                    <div class="cm-stat-lbl">Sold</div>
                </div>
            </div>
            <div class="cm-stat-card cm-stat-card-amber">
                <div class="cm-stat-icon-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <div>
                    <div class="cm-stat-num" id="totalViews">0</div>
                    <div class="cm-stat-lbl">Total views</div>
                </div>
            </div>
        </div>

        <!-- Quick links -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
            <a href="/products/new" class="cm-quick-card">
                <div class="cm-quick-icon" style="background:linear-gradient(135deg,#22C55E,#16A34A);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                </div>
                <div>
                    <div class="font-display font-bold text-cm-text">Sell an item</div>
                    <div class="text-xs text-cm-text/60">List in 3 quick steps</div>
                </div>
            </a>
            <a href="/saved-items" class="cm-quick-card">
                <div class="cm-quick-icon" style="background:linear-gradient(135deg,#F43F5E,#DB2777);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/></svg>
                </div>
                <div>
                    <div class="font-display font-bold text-cm-text">Saved items</div>
                    <div class="text-xs text-cm-text/60">Watchlist of favourites</div>
                </div>
            </a>
            <a href="/products/analytics/dashboard" class="cm-quick-card">
                <div class="cm-quick-icon" style="background:linear-gradient(135deg,#7C3AED,#A78BFA);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                </div>
                <div>
                    <div class="font-display font-bold text-cm-text">Analytics</div>
                    <div class="text-xs text-cm-text/60">Views &amp; performance</div>
                </div>
            </a>
        </div>

        <!-- My Listings -->
        <div class="cm-info-card mt-6">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <h2 class="font-display text-xl font-bold text-cm-text m-0">My listings</h2>
                <a href="/products/new" class="cm-btn-action cm-btn-action-cta" style="text-decoration:none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    New listing
                </a>
            </div>

            <div class="cm-tabs" role="tablist">
                <button class="cm-tab is-active" data-cm-tab="all" type="button" role="tab" aria-selected="true">All</button>
                <button class="cm-tab" data-cm-tab="active" type="button" role="tab" aria-selected="false">Active</button>
                <button class="cm-tab" data-cm-tab="sold" type="button" role="tab" aria-selected="false">Sold</button>
            </div>

            <div class="cm-tab-pane is-active" data-cm-pane="all"><div class="cm-grid" id="allListingsContainer"></div></div>
            <div class="cm-tab-pane" data-cm-pane="active" hidden><div class="cm-grid" id="activeListingsContainer"></div></div>
            <div class="cm-tab-pane" data-cm-pane="sold" hidden><div class="cm-grid" id="soldListingsContainer"></div></div>
        </div>

        <!-- Support -->
        <div class="cm-support-card mt-6">
            <div>
                <h3 class="font-display font-bold text-cm-text mb-1">Need help?</h3>
                <p class="text-cm-text/65 text-sm m-0">Account issues, safety concerns, anything.</p>
            </div>
            <a href="mailto:23uj1a0504@mrem.ac.in?subject=Help with my Campus Mart account" class="cm-btn-ghost cm-focus" style="border:1px solid var(--cm-border);">Contact support</a>
        </div>
    </div>
</section>

<!-- Edit Profile modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cm-modal">
            <div class="modal-header cm-modal-head">
                <h5 class="modal-title font-display font-bold" id="editProfileLabel">Edit profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/profile/<%= user._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                <div class="modal-body space-y-4">
                    <div>
                        <label class="cm-label" for="ep-name">Full name</label>
                        <input id="ep-name" type="text" name="user[fullName]" class="cm-input" value="<%= user.fullName %>" required />
                    </div>
                    <div>
                        <label class="cm-label" for="ep-email">Email</label>
                        <input id="ep-email" type="email" name="user[email]" class="cm-input" value="<%= user.email %>" required />
                    </div>
                    <div>
                        <label class="cm-label" for="ep-phone">Phone</label>
                        <input id="ep-phone" type="text" name="user[phone]" class="cm-input" value="<%= user.phone %>" required />
                    </div>
                    <div>
                        <label class="cm-label" for="ep-college">College</label>
                        <input id="ep-college" type="text" name="user[college]" class="cm-input" value="<%= user.college %>" required />
                    </div>
                    <div>
                        <label class="cm-label" for="ep-img">Profile image</label>
                        <input id="ep-img" type="file" name="profileImage" accept="image/*" class="cm-input" />
                        <small class="text-xs text-cm-text/55">Leave empty to keep current image.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cm-btn-ghost" style="border:1px solid var(--cm-border);" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="cm-btn-action cm-btn-action-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .cm-dashboard { background: var(--cm-bg); min-height: 100vh; }
    .cm-info-card { background: white; border: 1px solid var(--cm-border); border-radius: 22px; padding: 24px; box-shadow: 0 8px 28px -16px rgba(124,58,237,0.18); }
    .cm-profile-header { position: relative; overflow: hidden; }
    .cm-profile-bg { position: absolute; inset: 0; pointer-events: none; }
    .cm-profile-row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }
    .cm-profile-avatar {
        width: 88px;
        height: 88px;
        border-radius: 999px;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 8px 24px -10px rgba(124,58,237,0.45);
        flex-shrink: 0;
    }
    .cm-profile-avatar-init {
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Rubik', sans-serif;
        font-weight: 800;
        font-size: 36px;
    }
    .cm-profile-meta {
        list-style: none;
        padding: 0;
        margin: 8px 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
        font-size: 13px;
        color: var(--cm-muted);
    }
    .cm-profile-meta li { display: inline-flex; align-items: center; gap: 6px; }
    .cm-badge-verified {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #DCFCE7;
        color: #166534;
        font-size: 11px;
        font-weight: 700;
    }

    .cm-bento {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }
    @media (min-width: 768px) { .cm-bento { grid-template-columns: repeat(4, 1fr); } }
    .cm-stat-card {
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 18px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        overflow: hidden;
        transition: transform .25s, box-shadow .25s;
    }
    .cm-stat-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.06;
        pointer-events: none;
    }
    .cm-stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -14px rgba(124,58,237,0.35); }
    .cm-stat-card-violet::before  { background: linear-gradient(135deg, #7C3AED, #A78BFA); }
    .cm-stat-card-emerald::before { background: linear-gradient(135deg, #22C55E, #16A34A); }
    .cm-stat-card-blue::before    { background: linear-gradient(135deg, #3B82F6, #1D4ED8); }
    .cm-stat-card-amber::before   { background: linear-gradient(135deg, #F59E0B, #D97706); }
    .cm-stat-icon-lg {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: white;
    }
    .cm-stat-card-violet .cm-stat-icon-lg  { background: linear-gradient(135deg, #7C3AED, #A78BFA); }
    .cm-stat-card-emerald .cm-stat-icon-lg { background: linear-gradient(135deg, #22C55E, #16A34A); }
    .cm-stat-card-blue .cm-stat-icon-lg    { background: linear-gradient(135deg, #3B82F6, #1D4ED8); }
    .cm-stat-card-amber .cm-stat-icon-lg   { background: linear-gradient(135deg, #F59E0B, #D97706); }
    .cm-stat-num {
        font-family: 'Rubik', sans-serif;
        font-weight: 800;
        font-size: 24px;
        color: var(--cm-ink);
        line-height: 1;
    }
    .cm-stat-lbl {
        font-size: 12px;
        color: var(--cm-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 600;
        margin-top: 2px;
    }

    .cm-quick-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 16px;
        text-decoration: none;
        transition: transform .2s, border-color .2s, box-shadow .2s;
    }
    .cm-quick-card:hover { transform: translateY(-3px); border-color: var(--cm-primary); box-shadow: 0 12px 28px -14px rgba(124,58,237,0.35); }
    .cm-quick-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cm-tabs {
        display: inline-flex;
        gap: 4px;
        padding: 4px;
        background: var(--cm-bg);
        border: 1px solid var(--cm-border);
        border-radius: 12px;
        margin-bottom: 18px;
    }
    .cm-tab {
        background: transparent;
        border: none;
        padding: 8px 16px;
        font-family: 'Rubik', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--cm-text);
        border-radius: 8px;
        cursor: pointer;
        transition: background .2s, color .2s;
        min-height: 36px;
    }
    .cm-tab:hover { background: rgba(124,58,237,0.08); }
    .cm-tab.is-active { background: var(--cm-primary); color: white; }
    .cm-tab-pane[hidden] { display: none; }

    .cm-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }
    @media (min-width: 768px) { .cm-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 1280px) { .cm-grid { grid-template-columns: repeat(4, 1fr); } }
    .cm-mini-card {
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform .2s, border-color .2s, box-shadow .2s;
        position: relative;
    }
    .cm-mini-card:hover { transform: translateY(-3px); border-color: var(--cm-primary); box-shadow: 0 12px 28px -14px rgba(124,58,237,0.35); }
    .cm-mini-img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--cm-bg); position: relative; }
    .cm-mini-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
    .cm-mini-card:hover .cm-mini-img img { transform: scale(1.06); }
    .cm-mini-sold {
        position: absolute;
        top: 8px;
        right: 8px;
        background: #DC2626;
        color: white;
        font-size: 10px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 999px;
    }
    .cm-mini-body { padding: 12px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .cm-mini-title {
        font-family: 'Rubik', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--cm-ink);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cm-mini-price {
        font-family: 'Rubik', sans-serif;
        font-weight: 800;
        color: var(--cm-primary);
        font-size: 14px;
    }
    .cm-mini-actions { display: flex; gap: 6px; margin-top: auto; }
    .cm-mini-btn {
        flex: 1;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        padding: 8px 10px;
        border-radius: 8px;
        text-decoration: none;
        border: 1px solid var(--cm-border);
        color: var(--cm-text);
        background: white;
        transition: all .2s;
    }
    .cm-mini-btn:hover { border-color: var(--cm-primary); color: var(--cm-primary); }
    .cm-mini-btn-edit { background: #FEF3C7; color: #92400E; border-color: transparent; }
    .cm-mini-btn-edit:hover { background: #FDE68A; color: #78350F; border-color: transparent; }

    .cm-empty-listings {
        grid-column: 1 / -1;
        text-align: center;
        padding: 48px 16px;
        background: var(--cm-bg);
        border: 2px dashed var(--cm-border);
        border-radius: 18px;
        color: var(--cm-muted);
    }

    .cm-modal { border: 1px solid var(--cm-border); border-radius: 22px; overflow: hidden; }
    .cm-modal-head { background: linear-gradient(135deg, #FAF5FF, #F0FDF4); border-bottom: 1px solid var(--cm-border); }
    .cm-label { display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--cm-text); margin-bottom: 6px; }
    .cm-input { width: 100%; background: white; border: 1px solid var(--cm-border); border-radius: 12px; padding: 12px 14px; font-size: 14px; color: var(--cm-ink); font-family: inherit; transition: border-color .2s, box-shadow .2s; }
    .cm-input:focus { outline: none; border-color: var(--cm-primary); box-shadow: 0 0 0 3px rgba(124,58,237,0.12); }
    .space-y-4 > * + * { margin-top: 16px; }

    .cm-btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 18px; border-radius: 12px; font-family: 'Rubik', sans-serif; font-weight: 600; font-size: 14px; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: all .2s; min-height: 44px; }
    .cm-btn-action-primary { background: var(--cm-primary); color: white; }
    .cm-btn-action-primary:hover { background: #6D28D9; color: white; }
    .cm-btn-action-cta { background: var(--cm-cta); color: white; box-shadow: 0 6px 20px -8px rgba(34,197,94,0.5); }
    .cm-btn-action-cta:hover { background: #16A34A; color: white; }
    .cm-btn-action-ghost { background: white; color: var(--cm-text); border-color: var(--cm-border); }
    .cm-btn-action-ghost:hover { border-color: var(--cm-primary); color: var(--cm-primary); }
    .cm-btn-ghost { padding: 8px 14px; border-radius: 999px; color: var(--cm-text); font-weight: 600; font-size: 14px; text-decoration: none; transition: all .2s; min-height: 40px; display: inline-flex; align-items: center; }
    .cm-btn-ghost:hover { border-color: var(--cm-primary); color: var(--cm-primary); }

    .cm-support-card {
        background: white;
        border: 1px solid var(--cm-border);
        border-radius: 18px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }
</style>

<script>
    // Tabs
    document.querySelectorAll('.cm-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            var key = tab.getAttribute('data-cm-tab');
            document.querySelectorAll('.cm-tab').forEach(function (t) {
                t.classList.toggle('is-active', t === tab);
                t.setAttribute('aria-selected', t === tab);
            });
            document.querySelectorAll('.cm-tab-pane').forEach(function (p) {
                p.hidden = p.getAttribute('data-cm-pane') !== key;
            });
        });
    });

    async function loadUserProducts() {
        try {
            var resp = await fetch('/api/my-products');
            var products = await resp.json();
            var totalListings = products.length;
            var activeListings = products.filter(function (p) { return !p.isSold; }).length;
            var soldItems = products.filter(function (p) { return p.isSold; }).length;
            var totalViews = products.reduce(function (s, p) { return s + (p.viewCount || 0); }, 0);

            document.getElementById('totalListings').textContent  = totalListings;
            document.getElementById('activeListings').textContent = activeListings;
            document.getElementById('soldItems').textContent      = soldItems;
            document.getElementById('totalViews').textContent     = totalViews.toLocaleString('en-IN');

            renderProducts(products, 'allListingsContainer');
            renderProducts(products.filter(function (p) { return !p.isSold; }), 'activeListingsContainer');
            renderProducts(products.filter(function (p) { return p.isSold; }),  'soldListingsContainer');
        } catch (e) {
            console.error('Error loading products:', e);
        }
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
        });
    }

    function renderProducts(products, containerId) {
        var c = document.getElementById(containerId);
        if (!products.length) {
            c.innerHTML = '<div class="cm-empty-listings"><p class="m-0">No items in this view yet.</p></div>';
            return;
        }
        c.innerHTML = products.map(function (p) {
            var img = (p.images && p.images[0] && p.images[0].url) || '/images/default-product.jpg';
            return '' +
                '<div class="cm-mini-card">' +
                  '<div class="cm-mini-img">' +
                    '<img src="' + escapeHtml(img) + '" alt="' + escapeHtml(p.title) + '" loading="lazy" />' +
                    (p.isSold ? '<span class="cm-mini-sold">SOLD</span>' : '') +
                  '</div>' +
                  '<div class="cm-mini-body">' +
                    '<h3 class="cm-mini-title" title="' + escapeHtml(p.title) + '">' + escapeHtml(p.title) + '</h3>' +
                    '<span class="cm-mini-price">₹' + Number(p.price || 0).toLocaleString('en-IN') + '</span>' +
                    '<div class="cm-mini-actions">' +
                      '<a href="/products/' + p._id + '" class="cm-mini-btn">View</a>' +
                      (!p.isSold ? '<a href="/products/' + p._id + '/edit" class="cm-mini-btn cm-mini-btn-edit">Edit</a>' : '') +
                    '</div>' +
                  '</div>' +
                '</div>';
        }).join('');
    }

    loadUserProducts();
</script>
