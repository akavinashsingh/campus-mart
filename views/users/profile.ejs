<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <!-- User Profile Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-auto">
                    <% if(user.profileImage && user.profileImage.url) { %>
                        <img src="<%= user.profileImage.url %>" 
                             class="rounded-circle border" 
                             width="100" height="100" 
                             style="object-fit: cover;"
                             alt="<%= user.username %>">
                    <% } else { %>
                        <div class="rounded-circle d-flex align-items-center justify-content-center border" 
                             style="width: 100px; height: 100px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <span class="text-white fw-bold" style="font-size: 48px;">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    <% } %>
                </div>
                <div class="col">
                    <h3 class="mb-1"><%= user.username %></h3>
                    <p class="text-muted mb-2">
                        <i class="fas fa-envelope me-2"></i><%= user.email %>
                    </p>
                    <p class="text-muted mb-2">
                        <i class="fas fa-phone me-2"></i><%= user.phone %>
                    </p>
                    <p class="text-muted mb-2">
                        <i class="fas fa-university me-2"></i><%= user.college %>
                    </p>
                    <div class="mt-2">
                        <span class="badge bg-primary me-2">
                            <i class="fas fa-star"></i> <%= user.rating.toFixed(1) %> Rating
                        </span>
                        <span class="badge bg-info">
                            <%= user.totalRatings %> Reviews
                        </span>
                        <% if(user.isVerified) { %>
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Verified
                            </span>
                        <% } %>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-box-open fa-2x text-primary mb-2"></i>
                    <h4 class="mb-0" id="totalListings">0</h4>
                    <p class="text-muted mb-0">Total Listings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-store fa-2x text-success mb-2"></i>
                    <h4 class="mb-0" id="activeListings">0</h4>
                    <p class="text-muted mb-0">Active Listings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-check-circle fa-2x text-info mb-2"></i>
                    <h4 class="mb-0" id="soldItems">0</h4>
                    <p class="text-muted mb-0">Sold Items</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-eye fa-2x text-warning mb-2"></i>
                    <h4 class="mb-0" id="totalViews">0</h4>
                    <p class="text-muted mb-0">Total Views</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Link -->
    <div class="mb-4">
        <a href="/products/analytics/dashboard" class="btn btn-primary">
            <i class="fas fa-chart-line me-2"></i>View Detailed Analytics
        </a>
    </div>

    <!-- My Listings Section -->
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-list me-2"></i>My Listings</h4>
            <a href="/products/new" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New Listing
            </a>
        </div>
        <div class="card-body">
            <!-- Filter Tabs -->
            <ul class="nav nav-pills mb-4" id="listingTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="all-tab" data-bs-toggle="pill" data-bs-target="#all" type="button">
                        All
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="active-tab" data-bs-toggle="pill" data-bs-target="#active" type="button">
                        Active
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sold-tab" data-bs-toggle="pill" data-bs-target="#sold" type="button">
                        Sold
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="listingTabsContent">
                <!-- All Listings -->
                <div class="tab-pane fade show active" id="all" role="tabpanel">
                    <div class="row" id="allListingsContainer">
                        <!-- Products will be loaded here by JavaScript -->
                    </div>
                </div>

                <!-- Active Listings -->
                <div class="tab-pane fade" id="active" role="tabpanel">
                    <div class="row" id="activeListingsContainer">
                        <!-- Active products will be loaded here -->
                    </div>
                </div>

                <!-- Sold Listings -->
                <div class="tab-pane fade" id="sold" role="tabpanel">
                    <div class="row" id="soldListingsContainer">
                        <!-- Sold products will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/profile/<%= user._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" name="user[username]" class="form-control" value="<%= user.username %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="user[email]" class="form-control" value="<%= user.email %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="user[phone]" class="form-control" value="<%= user.phone %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">College</label>
                        <input type="text" name="user[college]" class="form-control" value="<%= user.college %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Profile Image</label>
                        <input type="file" name="profileImage" class="form-control" accept="image/*">
                        <small class="text-muted">Leave empty to keep current image</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Fetch and display user's products
    async function loadUserProducts() {
        try {
            const response = await fetch('/api/my-products');
            const products = await response.json();
            
            // Calculate stats
            const totalListings = products.length;
            const activeListings = products.filter(p => !p.isSold).length;
            const soldItems = products.filter(p => p.isSold).length;
            const totalViews = products.reduce((sum, p) => sum + (p.viewCount || 0), 0);
            
            // Update stats
            document.getElementById('totalListings').textContent = totalListings;
            document.getElementById('activeListings').textContent = activeListings;
            document.getElementById('soldItems').textContent = soldItems;
            document.getElementById('totalViews').textContent = totalViews.toLocaleString('en-IN');
            
            // Render products
            renderProducts(products, 'allListingsContainer');
            renderProducts(products.filter(p => !p.isSold), 'activeListingsContainer');
            renderProducts(products.filter(p => p.isSold), 'soldListingsContainer');
            
        } catch (error) {
            console.error('Error loading products:', error);
        }
    }
    
    function renderProducts(products, containerId) {
        const container = document.getElementById(containerId);
        
        if (products.length === 0) {
            container.innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No products found</p>
                </div>
            `;
            return;
        }
        
        container.innerHTML = products.map(product => `
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100 shadow-sm">
                    ${product.isSold ? '<div class="position-absolute top-0 end-0 m-2"><span class="badge bg-success">SOLD</span></div>' : ''}
                    <img src="${product.images[0]?.url || '/images/placeholder.jpg'}" 
                         class="card-img-top" 
                         style="height: 200px; object-fit: cover;" 
                         alt="${product.title}">
                    <div class="card-body">
                        <h6 class="card-title">${product.title}</h6>
                        <p class="text-primary fw-bold mb-2">₹${product.price.toLocaleString('en-IN')}</p>
                        <div class="d-flex gap-2">
                            <a href="/products/${product._id}" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="fas fa-eye"></i> View
                            </a>
                            ${!product.isSold ? `
                                <a href="/products/${product._id}/edit" class="btn btn-sm btn-warning flex-fill">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            ` : ''}
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    }
    
    // Load products on page load
    loadUserProducts();
</script>

<style>
    .nav-pills .nav-link {
        color: #6c757d;
    }
    .nav-pills .nav-link.active {
        background-color: #0d6efd;
    }
</style>
