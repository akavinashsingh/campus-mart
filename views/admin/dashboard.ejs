<% layout("/layouts/boilerplate") %>

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
        <form action="/admin/logout" method="POST">
            <button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
        </form>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Users</p>
                    <h3 class="mb-0"><%= stats.totalUsers %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Products</p>
                    <h3 class="mb-0"><%= stats.totalProducts %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Active Listings</p>
                    <h3 class="mb-0"><%= stats.activeProducts %></h3>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a href="/admin/users" class="btn btn-primary"><i class="fas fa-users me-1"></i>Manage Users</a>
        <a href="/admin/products" class="btn btn-secondary"><i class="fas fa-boxes me-1"></i>Manage Products</a>
    </div>

    <!-- Recent Contact Activity -->
    <% if(recentContacts && recentContacts.length > 0) { %>
        <div class="mt-5">
            <h4 class="mb-3"><i class="fas fa-envelope me-2"></i>Recent Contact Activity</h4>
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date/Time</th>
                                <th>Buyer</th>
                                <th>Seller</th>
                                <th>Product</th>
                                <th>Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentContacts.forEach(contact => { %>
                                <tr>
                                    <td>
                                        <small><%= new Date(contact.createdAt).toLocaleString() %></small>
                                    </td>
                                    <td>
                                        <% if(contact.buyer) { %>
                                            <%= contact.buyer.username %>
                                        <% } else { %>
                                            <span class="text-muted">Unknown</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(contact.seller) { %>
                                            <%= contact.seller.username %>
                                        <% } else { %>
                                            <span class="text-muted">Unknown</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(contact.product) { %>
                                            <%= contact.product.title %>
                                        <% } else { %>
                                            <span class="text-muted">Deleted</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= 
                                            contact.contactMethod === 'Email' ? 'primary' : 
                                            contact.contactMethod === 'WhatsApp' ? 'success' : 
                                            contact.contactMethod === 'Phone' ? 'info' : 'warning' 
                                        %>">
                                            <i class="fas fa-<%= 
                                                contact.contactMethod === 'Email' ? 'envelope' : 
                                                contact.contactMethod === 'WhatsApp' ? 'fab fa-whatsapp' : 
                                                contact.contactMethod === 'Phone' ? 'phone' : 'handshake' 
                                            %> me-1"></i>
                                            <%= contact.contactMethod %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-2">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Showing last 10 contact attempts
                </small>
            </div>
        </div>
    <% } %>
</div>
