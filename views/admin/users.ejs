<% layout("/layouts/boilerplate") %>

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fas fa-users me-2"></i>Users</h3>
        <a href="/admin" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>

    <% if (users.length === 0) { %>
        <div class="alert alert-info">No users found.</div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>College</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.fullName %></td>
                            <td><%= user.email %></td>
                            <td><%= user.college %></td>
                            <td>
                                <% if (user.isAdmin) { %>
                                    <span class="badge bg-danger">Admin</span>
                                <% } else { %>
                                    <span class="badge bg-primary">Student</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.isVerified) { %>
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-circle me-1"></i>Unverified</span>
                                <% } %>
                            </td>
                            <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                            <td class="text-end d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/users/<%= user._id %>">View</a>
                                <% if (!user.isAdmin) { %>
                                    <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this user and their content?');">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } else { %>
                                    <span class="text-muted small align-self-center">Protected</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
