<% layout("/layouts/boilerplate") %>

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fas fa-box-open me-2"></i>Products</h3>
        <a href="/admin" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>

    <% if (products.length === 0) { %>
        <div class="alert alert-info">No products found.</div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Owner</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Views</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                        <tr>
                            <td><%= product.title %></td>
                            <td><%= product.owner ? product.owner.username : 'N/A' %></td>
                            <td><%= product.category %></td>
                            <td>₹<%= product.price %></td>
                            <td>
                                <span class="badge bg-info">
                                    <i class="fas fa-eye me-1"></i><%= product.viewCount || 0 %>
                                </span>
                            </td>
                            <td><%= product.isSold ? 'Sold' : 'Active' %></td>
                            <td class="text-end">
                                <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this product?');">
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
